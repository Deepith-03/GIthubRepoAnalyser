# Environment Variables Example for GitHub Repo Analyser Backend
# Copy this file or set these variables in your environment before running the application.

# Google Gemini API Key (Required for AI Analysis and RAG Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: Increases rate limit from 60 to 5,000 requests/hr)
GITHUB_TOKEN=your_github_pat_here

# PostgreSQL Vector Store Credentials (Default matches docker-compose setup)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vector_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=adminpassword
